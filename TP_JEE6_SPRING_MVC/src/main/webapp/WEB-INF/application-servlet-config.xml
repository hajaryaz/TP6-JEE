<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context-2.5.xsd">

    <!--
        ============================================================
        CONTEXTE DU DISPATCHERSERVLET - application-servlet-config.xml
        ============================================================
        Ce fichier est charge par le DispatcherServlet (web.xml).
        Il configure la couche presentation / MVC.

        Separation des responsabilites :
           spring-beans.xml              -> DAO + Service (couche donnees/metier)
           application-servlet-config.xml -> Controller + ViewResolver (couche web)
        ============================================================
    -->

    <!--
        1. SCAN DES CONTROLLERS (Configuration par annotations)
        Spring recherche automatiquement les classes annotees
        avec @Controller dans le package "controller".
        Ces classes deviennent des Beans sans declaration XML.

        Permet de mixer XML (DAO/Service) et annotations (Controller).
    -->
    <context:component-scan base-package="controller"/>

    <!--
        2. VIEWRESOLVER (Configuration par XML)
        Traduit le nom de vue retourne par le Controller
        en chemin physique de fichier JSP.

        Exemple :
           Controller retourne "produits"
           ViewResolver cherche : /Pages/produits.jsp
                                  prefix + nom + suffix
    -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/Pages/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

</beans>
