<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
                                 http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <persistence-unit name="produitPU" transaction-type="RESOURCE_LOCAL">

        <!-- Classes entites JPA a gerer -->
        <class>dao.Produit</class>

        <properties>
            <!-- Connexion MySQL -->
            <property name="hibernate.connection.driver_class"
                      value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.connection.url"
                      value="jdbc:mysql://localhost:3306/gestion_produits?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"/>
            <property name="hibernate.connection.username" value="root"/>
            <property name="hibernate.connection.password" value=""/>

            <!-- Dialecte MySQL : indique a Hibernate quel SQL generer -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MySQL5InnoDBDialect"/>

            <!--
                hbm2ddl.auto=update :
                - Cree les tables si elles n'existent pas
                - Met a jour la structure si elle change
                - Ne supprime jamais les donnees existantes
            -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Afficher les requetes SQL dans la console (debug) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>
